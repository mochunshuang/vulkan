#version 450
#extension GL_ARB_separate_shader_objects:enable

layout(location=0)out vec3 fragColor;
layout(location=1)out vec3 normal;

// 立方体顶点位置
vec3 positions[36]=vec3[](
    // 前面
    vec3(-.5,-.5,.5),
    vec3(.5,-.5,.5),
    vec3(.5,.5,.5),
    vec3(.5,.5,.5),
    vec3(-.5,.5,.5),
    vec3(-.5,-.5,.5),
    
    // 右面
    vec3(.5,-.5,.5),
    vec3(.5,-.5,-.5),
    vec3(.5,.5,-.5),
    vec3(.5,.5,-.5),
    vec3(.5,.5,.5),
    vec3(.5,-.5,.5),
    
    // 后面
    vec3(.5,-.5,-.5),
    vec3(-.5,-.5,-.5),
    vec3(-.5,.5,-.5),
    vec3(-.5,.5,-.5),
    vec3(.5,.5,-.5),
    vec3(.5,-.5,-.5),
    
    // 左面
    vec3(-.5,-.5,-.5),
    vec3(-.5,-.5,.5),
    vec3(-.5,.5,.5),
    vec3(-.5,.5,.5),
    vec3(-.5,.5,-.5),
    vec3(-.5,-.5,-.5),
    
    // 上面
    vec3(-.5,.5,-.5),
    vec3(-.5,.5,.5),
    vec3(.5,.5,.5),
    vec3(.5,.5,.5),
    vec3(.5,.5,-.5),
    vec3(-.5,.5,-.5),
    
    // 下面
    vec3(-.5,-.5,-.5),
    vec3(.5,-.5,-.5),
    vec3(.5,-.5,.5),
    vec3(.5,-.5,.5),
    vec3(-.5,-.5,.5),
    vec3(-.5,-.5,-.5)
);

// 俯视45度的旋转矩阵（绕X轴旋转45度）
// 从正上方看下来，能看到立方体的上面和前面
mat3 rotationX=mat3(
    1.,0.,0.,// 1, 0, 0
    0.,.7071,-.7071,// 0, cos(45), -sin(45)
    0.,.7071,.7071// 0, sin(45), cos(45)
);

// 然后再绕Y轴旋转45度，让视角更好看
mat3 rotationY=mat3(
    .7071,0.,.7071,// cos(45), 0, sin(45)
    0.,1.,0.,// 0, 1, 0
    -.7071,0.,.7071// -sin(45), 0, cos(45)
);

// 缩放，让它在窗口中合适
mat3 scale=mat3(
    .8,0.,0.,
    0.,.8,0.,
    0.,0.,1.
);

// 颜色不变
vec3 colors[36]=vec3[](
    // 前面 - 红色
    vec3(.8,.1,.1),vec3(.8,.1,.1),vec3(.8,.1,.1),
    vec3(.8,.1,.1),vec3(.8,.1,.1),vec3(.8,.1,.1),
    
    // 右面 - 黄色
    vec3(.8,.8,.1),vec3(.8,.8,.1),vec3(.8,.8,.1),
    vec3(.8,.8,.1),vec3(.8,.8,.1),vec3(.8,.8,.1),
    
    // 后面 - 绿色
    vec3(.1,.8,.1),vec3(.1,.8,.1),vec3(.1,.8,.1),
    vec3(.1,.8,.1),vec3(.1,.8,.1),vec3(.1,.8,.1),
    
    // 左面 - 蓝色
    vec3(.1,.1,.8),vec3(.1,.1,.8),vec3(.1,.1,.8),
    vec3(.1,.1,.8),vec3(.1,.1,.8),vec3(.1,.1,.8),
    
    // 上面 - 青色
    vec3(.1,.8,.8),vec3(.1,.8,.8),vec3(.1,.8,.8),
    vec3(.1,.8,.8),vec3(.1,.8,.8),vec3(.1,.8,.8),
    
    // 下面 - 紫色
    vec3(.8,.1,.8),vec3(.8,.1,.8),vec3(.8,.1,.8),
    vec3(.8,.1,.8),vec3(.8,.1,.8),vec3(.8,.1,.8)
);

// 法线
vec3 normals[36]=vec3[](
    vec3(0.,0.,1.),vec3(0.,0.,1.),vec3(0.,0.,1.),// 前面
    vec3(0.,0.,1.),vec3(0.,0.,1.),vec3(0.,0.,1.),
    
    vec3(1.,0.,0.),vec3(1.,0.,0.),vec3(1.,0.,0.),// 右面
    vec3(1.,0.,0.),vec3(1.,0.,0.),vec3(1.,0.,0.),
    
    vec3(0.,0.,-1.),vec3(0.,0.,-1.),vec3(0.,0.,-1.),// 后面
    vec3(0.,0.,-1.),vec3(0.,0.,-1.),vec3(0.,0.,-1.),
    
    vec3(-1.,0.,0.),vec3(-1.,0.,0.),vec3(-1.,0.,0.),// 左面
    vec3(-1.,0.,0.),vec3(-1.,0.,0.),vec3(-1.,0.,0.),
    
    vec3(0.,1.,0.),vec3(0.,1.,0.),vec3(0.,1.,0.),// 上面
    vec3(0.,1.,0.),vec3(0.,1.,0.),vec3(0.,1.,0.),
    
    vec3(0.,-1.,0.),vec3(0.,-1.,0.),vec3(0.,-1.,0.),// 下面
    vec3(0.,-1.,0.),vec3(0.,-1.,0.),vec3(0.,-1.,0.)
);

void main(){
    vec3 pos=positions[gl_VertexIndex];
    vec3 nor=normals[gl_VertexIndex];
    
    // 先绕X轴旋转45度（俯视），再绕Y轴旋转45度（侧视）
    mat3 rotation=rotationY*rotationX;
    
    // 应用旋转和缩放
    pos=rotation*pos;
    pos=scale*pos;
    nor=rotation*nor;// 法线也要旋转
    
    gl_Position=vec4(pos,1.);
    fragColor=colors[gl_VertexIndex];
    normal=nor;
}